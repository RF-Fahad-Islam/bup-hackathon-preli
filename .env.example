# Required
OPENROUTER_API_KEY=

# Optional (defaults shown)
LLM_CHEAP_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash
LLM_STRONG_MODELS=anthropic/claude-sonnet-5,anthropic/claude-sonnet-4.6
