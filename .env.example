# At least one provider key is required
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional (defaults shown)
LLM_CHEAP_CHAIN=openrouter:openai/gpt-4.1-mini|google/gemini-2.5-flash,groq:openai/gpt-oss-20b|qwen/qwen3.8-27b
LLM_STRONG_CHAIN=openrouter:anthropic/claude-sonnet-5|anthropic/claude-sonnet-4.6,groq:openai/gpt-oss-120b|openai/gpt-oss-20b
LLM_PROVIDER_COOLDOWN_S=300
LLM_CHEAP_TIMEOUT_S=6
LLM_STRONG_TIMEOUT_S=10
INTERPRET_DEADLINE_S=20
INTERPRET_CACHE_SIZE=1000
PORT=8080
LOG_LEVEL=INFO
